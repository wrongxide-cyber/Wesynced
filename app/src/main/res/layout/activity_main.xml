<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- App Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp">

                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_menu_hamburger"
                        android:contentDescription="@string/drawer_open"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_tagline"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                    <!-- Compact connection controls -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <!-- Synced capsule -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardConnectionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:cardCornerRadius="9dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pastel_mint"
                            app:strokeWidth="0dp"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvConnectionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:text="Synced"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@color/mint_dark" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Disconnect capsule -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnDisconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardCornerRadius="9dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E53935"
                            app:strokeWidth="0dp"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="7dp"
                                android:paddingEnd="7dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:text="@string/btn_disconnect"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/white" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

                <!-- Pairing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPairing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pairing_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPairingId"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/hint_pairing_id"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="@color/pastel_purple">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPairingId"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:maxLength="16"
                                    android:fontFamily="monospace"
                                    android:textSize="15sp" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConnect"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/btn_connect"
                                android:backgroundTint="@color/pastel_purple"
                                android:textColor="@android:color/white"
                                app:cornerRadius="14dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGenerateId"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_generate_random"
                                android:textSize="12sp"
                                android:textColor="@color/pastel_purple_dark" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyId"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_copy_id"
                                android:textSize="12sp"
                                android:textColor="@color/pastel_purple_dark" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- My Current Mood + Partner Mood -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="22dp">

                    <!-- My Current Mood -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLivePreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/card_surface"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/my_current_mood"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="10dp" />

                            <!-- Ripple area -->
                            <FrameLayout
                                android:layout_width="140dp"
                                android:layout_height="140dp">

                                <!-- Outer ripple -->
                                <View
                                    android:id="@+id/viewMoodRippleOuter"
                                    android:layout_width="140dp"
                                    android:layout_height="140dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/mood_ripple_circle"
                                    android:alpha="0.0" />

                                <!-- Inner ripple -->
                                <View
                                    android:id="@+id/viewMoodRippleInner"
                                    android:layout_width="140dp"
                                    android:layout_height="140dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/mood_ripple_circle"
                                    android:alpha="0.0" />

                                <!-- Emoji -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="120dp"
                                    android:layout_height="120dp"
                                    android:layout_gravity="center"
                                    app:cardCornerRadius="60dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="@color/pastel_peach_light"
                                    app:strokeWidth="0dp">

                                    <TextView
                                        android:id="@+id/tvLivePreviewEmoji"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:text="♥️"
                                        android:textSize="64sp" />

                                </com.google.android.material.card.MaterialCardView>

                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvLivePreviewLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Safe and Sound"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hint_tap_to_change"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Partner Mood -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPartnerStatus"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:visibility="gone"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/pastel_lavender_light"
                        app:strokeWidth="0dp"
                        tools:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/partner_mood_title"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="10dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                app:cardCornerRadius="60dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/card_surface"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/tvFriendEmoji"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="♥️"
                                    android:textSize="64sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/tvFriendStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Safe and Sound"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ Live Sync"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/pastel_purple_dark"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Mood Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_mood_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp" />

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodHappy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="♥️"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodSleepy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="🥺"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPopcorn"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="🙄"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodGrumpy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="😞"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="4">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodHeart"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="🫩"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPartyTada"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="🫦"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPartyFace"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="💀"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCoffee"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="😕"
                                    android:textSize="32sp" />

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_surface"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
