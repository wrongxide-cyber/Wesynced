<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:animateLayoutChanges="true"
                android:padding="20dp">

                <!-- App Header: Hamburger + branding + status capsules -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp">

                    <ImageView
                        android:id="@+id/btnMenu"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_menu_hamburger"
                        android:contentDescription="@string/drawer_open"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardConnectionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pastel_mint"
                            app:strokeWidth="0dp"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/tvConnectionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="Synced"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/mint_dark" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDisconnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pastel_red_soft"
                            app:strokeWidth="0dp"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="6dp"
                                android:text="@string/btn_disconnect"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/red_dark" />
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </LinearLayout>

                <!-- Pairing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPairing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pairing_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPairingId"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/hint_pairing_id"
                                app:boxCornerRadiusTopStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxStrokeColor="@color/pastel_purple">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPairingId"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:maxLength="16"
                                    android:fontFamily="monospace"
                                    android:textSize="15sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConnect"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/btn_connect"
                                android:backgroundTint="@color/pastel_purple"
                                android:textColor="@android:color/white"
                                app:cornerRadius="14dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnGenerateId"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_generate_random"
                                android:textSize="12sp"
                                android:textColor="@color/pastel_purple_dark" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyId"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_copy_id"
                                android:textSize="12sp"
                                android:textColor="@color/pastel_purple_dark" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- My Mood + Partner's Mood, side by side, equal size.
                     Headers live OUTSIDE their square boxes so they never
                     overlap the floating mood text inside. Each square box
                     stacks 3 layers: (1) the box background itself,
                     (2) the twinkling mood text filling the box, and
                     (3) the circular emoji badge centered on top. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:layout_marginEnd="0dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/my_mood_label"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="@color/pastel_purple_dark"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardLivePreviewContainer"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pastel_peach_soft"
                            app:strokeWidth="0dp">

                            <!-- Layer stack: square box (card bg) -> twinkling text -> circular emoji -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <com.wesynced.app.TwinklingMoodTextView
                                    android:id="@+id/tvLivePreviewLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvLivePreviewEmoji"
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    android:layout_gravity="center" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0"
                        android:layout_marginStart="0dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:id="@+id/columnPartnerStatus">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/partner_mood_label"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="@color/pastel_purple_dark"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardPartnerStatus"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:visibility="gone"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/pastel_lavender_soft"
                            app:strokeWidth="0dp"
                            tools:visibility="visible">

                            <!-- Layer stack: square box (card bg) -> twinkling text -> circular emoji -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <com.wesynced.app.TwinklingMoodTextView
                                    android:id="@+id/tvFriendStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvFriendEmoji"
                                    android:layout_width="88dp"
                                    android:layout_height="88dp"
                                    android:layout_gravity="center" />

                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvFriendLastUpdated"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="center"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Mood Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card_surface"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/choose_mood_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp" />

                        <!-- Row 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodHappy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodHappy"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodSleepy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodSleepy"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPopcorn"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodPopcorn"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodGrumpy"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodGrumpy"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Row 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="4"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodHeart"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodHeart"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPartyTada"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodPartyTada"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodPartyFace"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodPartyFace"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCoffee"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/ivMoodCoffee"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Row 3: 4 custom user-defined slots -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="4">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCustom1"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvCustomEmoji1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCustom2"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvCustomEmoji2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCustom3"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvCustomEmoji3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnMoodCustom4"
                                android:layout_width="0dp"
                                android:layout_height="72dp"
                                android:layout_weight="1"
                                android:layout_margin="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="@color/pastel_lavender_soft"
                                app:strokeWidth="0dp">

                                <com.wesynced.app.EmojiView
                                    android:id="@+id/tvCustomEmoji4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Floating bubbles: fills the empty space left once pairing succeeds -->
                <FrameLayout
                    android:id="@+id/floatingBubbleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:clipChildren="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Branding header: everything else in this menu lives below it -->
            <include
                android:id="@+id/navHeaderInclude"
                layout="@layout/nav_header" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pastel_lavender_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp">

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_settings"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
