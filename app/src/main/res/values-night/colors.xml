<?xml version="1.0" encoding="utf-8"?>

<!--
  "Monochrome" theme palette.
  True/near-black background with a balanced, purely grayscale ramp of
  UI + text colors (white -> off-white -> light gray -> mid-gray ->
  dark gray). No hues from the Colorful palette carry over here, so
  every surface, badge, and accent in dark mode reads as high-contrast
  grayscale rather than a tinted dark version of the light theme.
-->
<resources>

    <color name="pastel_background">#0D0D0D</color>
    <color name="card_surface">#1A1A1A</color>

    <!-- Primary accent -- used for buttons, links, and mood-card headers -->
    <color name="pastel_purple">#CFCFCF</color>
    <color name="pastel_purple_dark">#F2F2F2</color>

    <!-- Partner's Mood square box -->
    <color name="pastel_lavender_light">#242424</color>
    <color name="pastel_lavender_soft">#1E1E1E</color>

    <!-- My Mood square box -->
    <color name="pastel_peach_light">#262626</color>
    <color name="pastel_peach_soft">#202020</color>

    <!-- "Synced" connection badge -->
    <color name="pastel_mint">#333333</color>
    <color name="pastel_mint_soft">#2A2A2A</color>
    <color name="mint_dark">#E6E6E6</color>

    <color name="pastel_butter_soft">#2C2C2C</color>
    <color name="pastel_rose_soft">#242424</color>
    <color name="pastel_brown_soft">#1C1C1C</color>

    <color name="text_primary">#F5F5F5</color>
    <color name="text_secondary">#ACACAC</color>

    <color name="switch_thumb">#F5F5F5</color>
    <color name="switch_track">#4D4D4D</color>

    <!-- "Disconnect" badge -->
    <color name="pastel_red_soft">#333333</color>
    <color name="red_dark">#EDEDED</color>

</resources>
